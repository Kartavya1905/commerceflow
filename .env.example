# Template for .env (git-ignored). scripts/dev-up.sh creates .env from this file on first run
# and replaces every CHANGE_ME value with a random secret, so normally you never edit it by hand.
# Keys added here later are appended to an existing .env automatically.

# --- PostgreSQL superuser (used only by the init script) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME

# --- One login role per service; each can connect only to its own database ---
IDENTITY_DB_PASSWORD=CHANGE_ME
CATALOG_DB_PASSWORD=CHANGE_ME
ORDER_DB_PASSWORD=CHANGE_ME
INVENTORY_DB_PASSWORD=CHANGE_ME
PAYMENT_DB_PASSWORD=CHANGE_ME
NOTIFICATION_DB_PASSWORD=CHANGE_ME
SANDBOX_DB_PASSWORD=CHANGE_ME

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME

# --- Grafana (http://localhost:3000) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# --- First admin account, created on identity-service startup if no admin exists ---
BOOTSTRAP_ADMIN_EMAIL=admin@commerceflow.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARS

# --- JWT signing key: generated by scripts/dev-up.sh into ./secrets (git-ignored) ---
# Used when identity-service runs on your machine (from the IDE). Containers get it as a secret.
# The key id is derived from the key itself (RFC 7638 thumbprint), so there is nothing to set.
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
