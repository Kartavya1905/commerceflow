# Copy to .env (git-ignored) and change every value marked CHANGE_ME before first run.
# Milestone 2 reads these from docker-compose; services read the same names.

# --- PostgreSQL superuser (used only by the init script) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME

# --- One login role per service; each can connect only to its own database ---
IDENTITY_DB_PASSWORD=CHANGE_ME
CATALOG_DB_PASSWORD=CHANGE_ME
ORDER_DB_PASSWORD=CHANGE_ME
INVENTORY_DB_PASSWORD=CHANGE_ME
PAYMENT_DB_PASSWORD=CHANGE_ME
NOTIFICATION_DB_PASSWORD=CHANGE_ME
SANDBOX_DB_PASSWORD=CHANGE_ME

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME

# --- First admin account, created on identity-service startup if no admin exists ---
BOOTSTRAP_ADMIN_EMAIL=admin@commerceflow.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARS

# --- JWT signing key: generated by scripts/dev-up into ./secrets (git-ignored) ---
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_KEY_ID=local-1
