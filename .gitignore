# Build output
target/
!.mvn/wrapper/maven-wrapper.jar
*.class

# Local configuration and secrets: never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
secrets/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Frontend
node_modules/
dist/
# Playwright traces record request bodies and tokens: never commit them.
frontend/test-results/
frontend/playwright-report/

# IDE and OS
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Test and load-test output
*.log
load-tests/k6/results/

# Kubernetes: rendered manifests (check-k8s.sh) and per-build image tags (kind-up.sh)
deploy/k8s/.rendered/
deploy/k8s/.generated/
