{
  "name": "commerceflow-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CommerceFlow customer and admin web app. Talks only to the API gateway, through the same origin.",
  "scripts": {
    "generate": "node scripts/generate-api.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.1.17",
    "@types/node": "22.20.5",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
