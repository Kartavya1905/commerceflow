# LF in the repository and in every working copy, even where Git is configured with
# core.autocrlf=true (the Git for Windows default). Spotless checks for LF, and shell scripts run
# in Linux containers fail with "bad interpreter" if they arrive with CRLF.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.jar binary
*.png binary
