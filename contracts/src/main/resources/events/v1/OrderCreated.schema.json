{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.commerceflow.local/events/v1/OrderCreated.schema.json",
  "title": "OrderCreated v1",
  "description": "An order was accepted and saved as PENDING. Inventory treats it as a reservation request.",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "eventType": { "const": "OrderCreated" },
    "eventVersion": { "const": 1 },
    "producer": { "const": "order-service" },
    "aggregateType": { "const": "Order" },
    "payload": {
      "type": "object",
      "required": ["orderId", "customerId", "items", "totalMinor", "currency"],
      "properties": {
        "orderId": { "$ref": "envelope.schema.json#/$defs/uuid" },
        "customerId": { "$ref": "envelope.schema.json#/$defs/uuid" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["productId", "quantity", "unitPriceMinor"],
            "properties": {
              "productId": { "$ref": "envelope.schema.json#/$defs/uuid" },
              "quantity": { "$ref": "envelope.schema.json#/$defs/quantity" },
              "unitPriceMinor": { "$ref": "envelope.schema.json#/$defs/amountMinor" }
            },
            "additionalProperties": false
          }
        },
        "totalMinor": { "$ref": "envelope.schema.json#/$defs/amountMinor" },
        "currency": { "$ref": "envelope.schema.json#/$defs/currency" }
      },
      "additionalProperties": false
    }
  }
}
