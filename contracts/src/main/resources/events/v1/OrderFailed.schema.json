{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.commerceflow.local/events/v1/OrderFailed.schema.json",
  "title": "OrderFailed v1",
  "description": "Terminal failure, published only after every compensation has completed.",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "eventType": { "const": "OrderFailed" },
    "eventVersion": { "const": 1 },
    "producer": { "const": "order-service" },
    "aggregateType": { "const": "Order" },
    "payload": {
      "type": "object",
      "required": ["orderId", "customerId", "reason"],
      "properties": {
        "orderId": { "$ref": "envelope.schema.json#/$defs/uuid" },
        "customerId": { "$ref": "envelope.schema.json#/$defs/uuid" },
        "reason": {
          "enum": [
            "OUT_OF_STOCK",
            "PAYMENT_DECLINED",
            "PAYMENT_TIMEOUT",
            "PRICE_UNAVAILABLE",
            "INTERNAL_ERROR"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 500,
          "description": "Human-readable context. Must not contain personal data."
        }
      },
      "additionalProperties": false
    }
  }
}
