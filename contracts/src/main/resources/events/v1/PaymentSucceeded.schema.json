{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.commerceflow.local/events/v1/PaymentSucceeded.schema.json",
  "title": "PaymentSucceeded v1",
  "description": "The provider confirmed the charge.",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "eventType": { "const": "PaymentSucceeded" },
    "eventVersion": { "const": 1 },
    "producer": { "const": "payment-service" },
    "aggregateType": { "const": "OrderPayment" },
    "payload": {
      "type": "object",
      "required": ["orderId", "paymentAttemptId", "providerChargeId", "amountMinor", "currency"],
      "properties": {
        "orderId": { "$ref": "envelope.schema.json#/$defs/uuid" },
        "paymentAttemptId": { "$ref": "envelope.schema.json#/$defs/paymentAttemptId" },
        "providerChargeId": { "type": "string", "pattern": "^ch_[A-Za-z0-9]{8,64}$" },
        "amountMinor": { "$ref": "envelope.schema.json#/$defs/positiveAmountMinor" },
        "currency": { "$ref": "envelope.schema.json#/$defs/currency" }
      },
      "additionalProperties": false
    }
  }
}
