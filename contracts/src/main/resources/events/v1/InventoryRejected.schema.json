{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.commerceflow.local/events/v1/InventoryRejected.schema.json",
  "title": "InventoryRejected v1",
  "description": "At least one line could not be reserved; nothing was reserved for the order.",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "eventType": { "const": "InventoryRejected" },
    "eventVersion": { "const": 1 },
    "producer": { "const": "inventory-service" },
    "aggregateType": { "const": "OrderReservation" },
    "payload": {
      "type": "object",
      "required": ["orderId", "reason", "productIds"],
      "properties": {
        "orderId": { "$ref": "envelope.schema.json#/$defs/uuid" },
        "reason": { "enum": ["OUT_OF_STOCK", "UNKNOWN_PRODUCT"] },
        "productIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "envelope.schema.json#/$defs/uuid" }
        }
      },
      "additionalProperties": false
    }
  }
}
